# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 — build the React app
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder






WORKDIR /app

# Install deps first (better cache)
COPY frontend/package*.json ./
RUN npm ci || npm install

# Copy source and build
COPY frontend/ .
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — serve with nginx (tiny, prod-grade)
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# SPA routing + backend proxy for API and agent dashboards
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    resolver 127.0.0.11 valid=10s ipv6=off;\n\
    set $backend_upstream backend:8000;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    # Max upload size accepted by nginx before it even reaches the backend.\n\
    # Default is 1M — raised here so CSV/Excel/large file uploads via\n\
    # /api/upload_file do not get rejected with 413 Request Entity Too Large.\n\
    # Adjust this number (in M/G) to whatever your largest expected file is.\n\
    client_max_body_size 500M;\n\
    location /api/ {\n\
        rewrite ^/api/(.*)$ /$1 break;\n\
        proxy_pass http://$backend_upstream;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        # Large uploads take longer than the default 60s — extend the\n\
        # timeouts so slow/large transfers are not cut off mid-upload.\n\
        proxy_read_timeout 300s;\n\
        proxy_send_timeout 300s;\n\
        client_body_timeout 300s;\n\
    }\n\
    location /agent/ {\n\
        proxy_pass http://$backend_upstream;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]