# =============================================================
# Data Intelligence Platform — environment configuration
#
# Copy to .env and fill in. .env is gitignored; never commit it.
#   cp .env.example .env
#
# Keys are grouped by concern and alphabetical within each group.
# Required keys are marked [required]; everything else has a working
# default or is only needed for the feature named in its section.
# =============================================================


# -------------------------------------------------------------
# Database (PostgreSQL) — [required]
# -------------------------------------------------------------
# Use "postgres" as the host when running via docker-compose,
# "localhost" when running the backend directly.
DB_HOST=postgres
DB_NAME=airflow
DB_PASSWORD=
DB_PORT=5432
DB_USER=airflow


# -------------------------------------------------------------
# LLM provider — [required]
# -------------------------------------------------------------
# LLM_PROVIDER selects the client: groq | openrouter
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Only needed when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Text-to-SQL generation tuning
TEXT_SQL_MAX_RETRIES=2
TEXT_SQL_TEMPERATURE=0.0


# -------------------------------------------------------------
# Claude agent (optional — dashboard generation)
# -------------------------------------------------------------
# Supply either ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

CLAUDE_AGENT_FALLBACK_MODEL=haiku
CLAUDE_AGENT_MAX_BUDGET_USD=0.15
CLAUDE_AGENT_MODEL=sonnet
CLAUDE_AGENT_SDK_ENABLED=true


# -------------------------------------------------------------
# Airflow — [required]
# -------------------------------------------------------------
# Use the airflow-webserver hostname under docker-compose,
# localhost:8080 when running Airflow outside the compose network.
AIRFLOW_BASE_URL=http://airflow-webserver:8080/api/v1/dags
AIRFLOW_PASSWORD=admin
AIRFLOW_USER=admin

# Consumed by docker-compose for the Airflow webserver/scheduler
AIRFLOW__WEBSERVER__SECRET_KEY=


# -------------------------------------------------------------
# Filesystem paths
# -------------------------------------------------------------
CONTAINER_DATASET_PATH=/opt/airflow/dataset
CONTAINER_DATA_PATH=/opt/airflow/data
DAGS_FOLDER=/app/dags
UPLOAD_BASE_DIR=

# Host-side bind mount sources used by docker-compose
WINDOWS_DATASET_PATH=./Dataset
WINDOWS_DATA_PATH=./data


# -------------------------------------------------------------
# Snowflake (optional — Snowflake connector & text-to-SQL)
# -------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=

# Regenerates AGENT/metadata/business_context.json at backend startup when
# the Snowflake schema has changed. Off by default: it opens a Snowflake
# connection and can trigger LLM calls on every boot.
SNOWFLAKE_SCHEMA_CHECK_ON_STARTUP=false


# -------------------------------------------------------------
# AWS S3 (optional — S3 connector & data generator)
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PATH_PREFIX=


# -------------------------------------------------------------
# Email alerts (optional — pipeline failure notifications)
# -------------------------------------------------------------
EMAIL_PASSWORD=
EMAIL_RECEIVER=
EMAIL_SENDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587


# -------------------------------------------------------------
# Figma connector (optional)
# -------------------------------------------------------------
FIGMA_ACCESS_TOKEN=


# -------------------------------------------------------------
# Backend runtime
# -------------------------------------------------------------
# AGENT_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
AGENT_LOG_LEVEL=INFO
PORT=8000


# -------------------------------------------------------------
# Frontend (build-time — Vite inlines VITE_* into the bundle,
# so never put a secret here)
# -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
