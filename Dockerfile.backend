FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Project files
COPY backend/connectors/     ./connectors/
COPY backend/utils/          ./utils/
COPY backend/loaders/        ./loaders/
COPY backend/agent/          ./agent/
COPY backend/text_sql/       ./text_sql/
COPY backend/data_generator/ ./data_generator/
COPY backend/sql_executors/  ./sql_executors/
COPY backend/testers/        ./testers/
COPY backend/generator/      ./generator/
COPY backend/metadata/       ./metadata/
COPY backend/quality/        ./quality/
COPY backend/sql_router.py   .
COPY backend/main.py         .
COPY backend/run.py          .

# Required folders
RUN mkdir -p dags data backups

EXPOSE 8000

CMD ["python", "run.py"]